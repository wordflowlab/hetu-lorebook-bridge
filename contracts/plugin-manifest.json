              "maxItems": 300
            },
            "mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "exchange_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "field_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "target_kind": {
                    "type": "string",
