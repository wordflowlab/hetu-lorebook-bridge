  "version": "0.1.0",
  "display": {
    "zh-CN": "世界书互通",
    "en": "Lorebook Bridge"
  },
  "description": {
    "zh-CN": "让角色卡和世界书在不同创作工具之间有据交换，保留未知字段，明确转换损失。",
    "en": "Lorebook Bridge with fixed sources and external Agent workflows."
  },
  "license": "Apache-2.0",
  "dependencies": [],
  "work_kinds": [
    "novel"
  ],
  "runtime": {
    "entry": "backend.mjs"
  },
  "contributions": {
    "views": [
      {
        "id": "main",
        "title": "世界书互通",
        "entry": "index.html",
        "object_kinds": [
          "lorebook_bridge"
        ],
        "navigation": "integrated"
      }
    ],
