        "schema_version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format_version": {
              "const": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "exchanges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "filename": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "file_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "png",
                      "charx"
                    ]
                  },
                  "spec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "raw_json": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240000
                  },
                  "asset_source_index": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 99
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "title",
                  "filename",
                  "file_sha256",
                  "format",
                  "spec",
                  "raw_json",
                  "asset_source_index"
